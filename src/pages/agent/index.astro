---
import '../../styles/global.css';
import {readSite} from '../../lib/agent-reader';
const site=await readSite();
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{site.title} · Agent Reader</title><link rel="canonical" href={new URL('agent/',site.home)}/></head><body class="bg-bg text-text"><article class="max-w-3xl mx-auto px-5 py-8 relative z-10" aria-labelledby="reader-title"><p class="text-sm mb-3">公开站点索引</p><h1 id="reader-title" class="text-3xl font-semibold mb-4">{site.title} · Agent Reader</h1><p class="mb-5">{site.description}</p><p class="my-4"><a class="underline" href={site.home}>返回网站</a> · <a class="underline" href={site.source}>公开源码</a> · <a class="underline" href={new URL('agent/site.json',site.home)}>JSON</a></p><div class="space-y-6">{site.sections.map(s=><section><h2 class="text-xl font-semibold my-3"><a class="underline" href={s.url}>{s.title}</a></h2><p>{s.description}</p>{'reference' in s&&s.reference&&<p><a class="underline" href={s.reference.url}>{s.reference.title}</a></p>}<ul class="list-disc pl-6 space-y-2">{s.items.map(i=><li><a class="underline break-words" href={i.url}>{i.title}</a> — {i.description}</li>)}</ul></section>)}<section><h2 class="text-xl font-semibold my-3">使用边界</h2><ul class="list-disc pl-6">{site.limitations.map(t=><li>{t}</li>)}</ul></section></div></article></body></html>
